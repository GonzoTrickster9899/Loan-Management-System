# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/loan_management_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production_2024
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@loanmanagement.com
EMAIL_FROM_NAME=Loan Management System

# Client URL (for CORS and email links)
CLIENT_URL=http://localhost:5173

# 2FA Configuration
TWO_FA_APP_NAME=LoanManagementSystem

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
